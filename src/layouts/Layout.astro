---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import '../styles/global.css';

const { title } = Astro.props;
---

<html lang="ja">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content="Official website of Hiroki Kubota, contemporary artist based in Japan." />
    <meta property="og:title" content="KUBOTA HIROKI" />
    <meta property="og:description" content="Official website of Hiroki Kubota, contemporary artist based in Japan." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kubotahiroki.com/" />
    <meta property="og:image" content="https://kubotahiroki.com/ogp.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="KUBOTA HIROKI" />
    <meta name="twitter:description" content="Official website of Hiroki Kubota, contemporary artist based in Japan." />
    <meta name="twitter:image" content="https://kubotahiroki.com/ogp.jpg" />
    <title>久保田 浩貴 - kubota hiroki - {title}</title>
</head>

<body>

<Header />

<main>

<slot />

</main>

<Footer />

</body>
</html>
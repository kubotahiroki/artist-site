---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cv">
<div class="content-title">
    <div class="content-wide-normal">
        <h2>CV</h2>
    </div>
</div>
    <div class="content-wide-normal">
        <div class="cv-block">
            <h3>経歴</h3>
            <ul>
                <li>1988年 鹿児島生まれ</li>
                <li>2011年 東京造形大学造形学部美術学科絵画専攻領域卒業</li>
            </ul>
        </div>
        <div class="cv-block">
            <h3>個展</h3>
            <ul>
                <li>2024年 「KKIC」 Space Banksia（東京）</li>
                <li>2025年 「Identity」 ギャラリー58（東京）</li>
                <li>2026年 「Break time」MEM HATAGAYA COFFEE BAR （東京）</li>
                <li>2026年 「Cultural Being」 ギャラリー58（東京）</li>
            </ul>
        </div>
        <div class="cv-block">
            <h3>グループ展</h3>
            <ul>
                <li>2025年 「羅針盤セレクション 7人展」アートスペース羅針盤（東京）</li>
                <li>2026年 「Square展」ギャラリー58（東京）</li>
            </ul>
        </div>

    </div>

</Layout>